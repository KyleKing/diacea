@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Container(is_there_a_shape_under_the_pointer, "Is there a shape \nunder the pointer?")
Container(is_the_user_holding_the_shift_key_and_no, "Is the user \nholding the shift key? \n(and not the alt key)")
Container(is_the_outermost_selectable_shape_select, "Is the outermost \nselectable shape selected?")
Component(cancel_any_double_click, "Cancel any double click")
ComponentDb(select_the_hit_shape, "Select the hit shape")
ComponentDb(select_the_outermost_selectable_shape, "Select the outermost selectable shape")
ComponentDb(add_the_outermost_selectable_shape_to_se, "Add the outermost selectable shape to selection")
ComponentDb(de_select_the_outermost_selectable_shape, "De-select the outermost selectable shape")
Container(is_oss_shape_the_same_as_the_hit_shape, "Is OSS shape the same \nas the hit shape?")
Container(is_oss_shape_the_focus_layer_id, "Is OSS shape\nthe focus layer id?")
Container(is_oss_shape_selected, "Is OSS shape\nselected?")


Rel(is_there_a_shape_under_the_pointer, is_the_user_holding_the_shift_key_and_no, "Yes")
Rel(cancel_any_double_click, is_the_outermost_selectable_shape_select, "")
Rel(is_the_outermost_selectable_shape_select, de_select_the_outermost_selectable_shape, "No")
Rel(is_the_outermost_selectable_shape_select, add_the_outermost_selectable_shape_to_se, "Yes")
Rel(is_the_user_holding_the_shift_key_and_no, cancel_any_double_click, "Yes")
Rel(is_oss_shape_the_same_as_the_hit_shape, select_the_hit_shape, "Yes")
Rel(is_oss_shape_the_focus_layer_id, select_the_hit_shape, "Yes")
Rel(is_oss_shape_the_same_as_the_hit_shape, is_oss_shape_the_focus_layer_id, "No")
Rel(is_oss_shape_the_focus_layer_id, is_oss_shape_selected, "No")
Rel(is_the_user_holding_the_shift_key_and_no, is_oss_shape_the_same_as_the_hit_shape, "No")
Rel(is_oss_shape_selected, select_the_hit_shape, "Yes")
Rel(is_oss_shape_selected, select_the_outermost_selectable_shape, "No")
@enduml
