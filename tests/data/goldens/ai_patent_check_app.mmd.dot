digraph "AI Patent Infringement Check App" {
    rankdir="TB";
    node [shape="box", fontname="Helvetica"];
    edge [fontname="Helvetica"];

    subgraph cluster_group_Client {
        label="Client Layer";
        Browser [label="User's Browser"];
        Frontend [label="React Frontend (Dockerized)"];
    }
    subgraph cluster_group_Backend {
        label="Server Layer (Dockerized)";
        NodeBackend [label="Node.js Backend"];
        Template [label="OpenAI Prompt Template"];
        subgraph cluster_group_Processing {
            label="Data Processing";
            InputHandler [label="Patent ID & Company Input Handler"];
        }
    }
    subgraph cluster_group_External {
        label="External Services";
        OpenAI [label="OpenAI API"];
    }

    Browser -> Frontend;
    Frontend -> NodeBackend;
    NodeBackend -> InputHandler;
    InputHandler -> Template;
    Template -> InputHandler;
    InputHandler -> NodeBackend;
    NodeBackend -> OpenAI [label="Prompt with Patent & Company Info"];
    OpenAI -> NodeBackend [label="Response Standard JSON"];
    NodeBackend -> Frontend;
}
