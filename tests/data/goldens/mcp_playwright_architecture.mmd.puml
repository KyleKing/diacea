@startuml
left to right direction
rectangle "LLM Response" as E
rectangle "User Interface" as F
rectangle "Frontend" as group_Frontend {
  rectangle "User Input" as A
}
rectangle "MCP" as group_MCP {
  rectangle "1 Preprocessing: Parse Intent, Clean Text" as B1
  rectangle "2 Context Management: Retrieve Conversation History, Memory, Relevant Knowledge" as B2
  rectangle "3 Conditional Check: Whether Web Query is Needed" as B3
  rectangle "4a RAG Data Retrieval from Context Database" as B4a
  rectangle "4b Web Browsing: Call Playwright MCP Server" as B5
  rectangle "5 Prompt Assembly: Merge User Input + Context + Query Results" as B6
  rectangle "6 Call LLM API" as B7
  rectangle "7 Post-processing: Filter, Format, Supplement" as B8
  rectangle "8 Memory Storage: Update Conversation History, User Preferences" as B9
  rectangle "9 Return Results" as B10
}
rectangle "Playwright MCP Server" as group_Playwright_MCP_Server {
  rectangle "Receive MCP Query Request" as P1
  rectangle "Launch Headless Browser" as P2
  rectangle "Navigate to Target Page" as P3
  rectangle "Extract Required Data such as Tables, Prices, Latest Announcements" as P4
  rectangle "Return JSON Results" as P5
}
A --> B1
B1 --> B2
B2 --> B3
B3 --> B5 : "Yes"
B3 --> B4a : "No"
B4a --> B2
B5 --> P1
P1 --> P2
P2 --> P3
P3 --> P4
P4 --> P5
P5 --> B5
B2 --> B6
B6 --> B7
B7 --> E
E --> B8
B8 --> B9
B9 --> B10
B10 --> F
@enduml
