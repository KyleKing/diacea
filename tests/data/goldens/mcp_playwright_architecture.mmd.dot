digraph "MCP Architecture Flow with Web Browsing Integration" {
    rankdir="LR";
    node [shape="box", fontname="Helvetica"];
    edge [fontname="Helvetica"];

    subgraph cluster_group_Frontend {
        label="Frontend";
        A [label="User Input"];
    }
    subgraph cluster_group_MCP {
        label="MCP";
        B1 [label="1 Preprocessing: Parse Intent, Clean Text"];
        B2 [label="2 Context Management: Retrieve Conversation History, Memory, Relevant Knowledge"];
        B3 [label="3 Conditional Check: Whether Web Query is Needed"];
        B4a [label="4a RAG Data Retrieval from Context Database"];
        B5 [label="4b Web Browsing: Call Playwright MCP Server"];
        B6 [label="5 Prompt Assembly: Merge User Input + Context + Query Results"];
        B7 [label="6 Call LLM API"];
        B8 [label="7 Post-processing: Filter, Format, Supplement"];
        B9 [label="8 Memory Storage: Update Conversation History, User Preferences"];
        B10 [label="9 Return Results"];
    }
    subgraph cluster_group_Playwright_MCP_Server {
        label="Playwright MCP Server";
        P1 [label="Receive MCP Query Request"];
        P2 [label="Launch Headless Browser"];
        P3 [label="Navigate to Target Page"];
        P4 [label="Extract Required Data such as Tables, Prices, Latest Announcements"];
        P5 [label="Return JSON Results"];
    }

    E [label="LLM Response"];
    F [label="User Interface"];

    A -> B1;
    B1 -> B2;
    B2 -> B3;
    B3 -> B5 [label="Yes"];
    B3 -> B4a [label="No"];
    B4a -> B2;
    B5 -> P1;
    P1 -> P2;
    P2 -> P3;
    P3 -> P4;
    P4 -> P5;
    P5 -> B5;
    B2 -> B6;
    B6 -> B7;
    B7 -> E;
    E -> B8;
    B8 -> B9;
    B9 -> B10;
    B10 -> F;
}
