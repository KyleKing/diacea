digraph "diagram" {
    rankdir="LR";
    node [shape="box", fontname="Helvetica"];
    edge [fontname="Helvetica"];

    User [label="User", fillcolor="#87CEEB", style="filled"];
    API [label="API Gateway", fillcolor="#90EE90", style="filled"];
    Auth [label="Auth Service"];
    Orders [label="Order Service"];
    Products [label="Product Service"];
    AuthDB [label="Auth Database", shape="cylinder"];
    OrderDB [label="Order Database", shape="cylinder"];
    ProductDB [label="Product Database", shape="cylinder"];
    Queue [label="Message Queue", fillcolor="#FFD700", style="filled"];
    Inventory [label="Inventory Service"];
    InvDB [label="Inventory Database", shape="cylinder"];

    User -> API;
    API -> Auth;
    API -> Orders;
    API -> Products;
    Auth -> AuthDB;
    Orders -> OrderDB;
    Products -> ProductDB;
    Orders -> Queue;
    Queue -> Inventory;
    Inventory -> InvDB;
}
