digraph "SVG Diagram" {
    rankdir="LR";
    node [shape="box", fontname="Helvetica"];
    edge [fontname="Helvetica"];

    rect1 [label="Web Server", fillcolor="#E3F2FD", style="filled", color="#1976D2", penwidth="2.0"];
    circle1 [label="User", shape="ellipse", fillcolor="#FFEBEE", style="filled", color="#C62828", penwidth="2.0"];
    ellipse1 [label="Database", shape="cylinder", fillcolor="#E8F5E9", style="filled", color="#388E3C", penwidth="2.0"];
    diamond1 [label="Decision", shape="diamond", fillcolor="#FFF3E0", style="filled", color="#F57C00", penwidth="2.0"];
    rect2 [label="Service", color="#4CAF50", penwidth="3.0"];

}
