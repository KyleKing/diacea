direction: right

group-Frontend: Frontend {
  A: User Input
}

group-MCP: MCP {
  B1: "1 Preprocessing: Parse Intent, Clean Text"
  B2: "2 Context Management: Retrieve Conversation History, Memory, Relevant Knowledge"
  B3: "3 Conditional Check: Whether Web Query is Needed"
  B4a: 4a RAG Data Retrieval from Context Database
  B5: "4b Web Browsing: Call Playwright MCP Server"
  B6: "5 Prompt Assembly: Merge User Input + Context + Query Results"
  B7: 6 Call LLM API
  B8: "7 Post-processing: Filter, Format, Supplement"
  B9: "8 Memory Storage: Update Conversation History, User Preferences"
  B10: 9 Return Results
}

group-Playwright_MCP_Server: Playwright MCP Server {
  P1: Receive MCP Query Request
  P2: Launch Headless Browser
  P3: Navigate to Target Page
  P4: Extract Required Data such as Tables, Prices, Latest Announcements
  P5: Return JSON Results
}

E: LLM Response
F: User Interface

group-Frontend.A -> group-MCP.B1
group-MCP.B1 -> group-MCP.B2
group-MCP.B2 -> group-MCP.B3
group-MCP.B3 -> group-MCP.B5: Yes
group-MCP.B3 -> group-MCP.B4a: No
group-MCP.B4a -> group-MCP.B2
group-MCP.B5 -> group-Playwright_MCP_Server.P1
group-Playwright_MCP_Server.P1 -> group-Playwright_MCP_Server.P2
group-Playwright_MCP_Server.P2 -> group-Playwright_MCP_Server.P3
group-Playwright_MCP_Server.P3 -> group-Playwright_MCP_Server.P4
group-Playwright_MCP_Server.P4 -> group-Playwright_MCP_Server.P5
group-Playwright_MCP_Server.P5 -> group-MCP.B5
group-MCP.B2 -> group-MCP.B6
group-MCP.B6 -> group-MCP.B7
group-MCP.B7 -> E
E -> group-MCP.B8
group-MCP.B8 -> group-MCP.B9
group-MCP.B9 -> group-MCP.B10
group-MCP.B10 -> F
