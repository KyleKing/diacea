direction: right

group-ResultsComponent: ResultsComponent {
  GameDropDown: GameDropDown
  DateFilterBar: DateFilterBar
  Loop_ResultContainer: "Loop:ResultContainer"
  group-ResultContainer: ResultContainer {
    ResultBallLoader: ResultBallLoader
    ResultSummaryLoader: ResultSummaryLoader
  }

}

API_Results: "API:Results"
State_LayoutConfig: "State:LayoutConfig"
GeneralSummaryResult: GeneralSummaryResult
TwoRowsBallResult: TwoRowsBallResult
