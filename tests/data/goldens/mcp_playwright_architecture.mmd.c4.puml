@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Component(E, "LLM Response")
Container(F, "User Interface")

System_Boundary(group_Frontend, "Frontend") {
  Component(A, "User Input")
}
System_Boundary(group_MCP, "MCP") {
  Component(B1, "1 Preprocessing: Parse Intent, Clean Text")
  Component(B2, "2 Context Management: Retrieve Conversation History, Memory, Relevant Knowledge")
  Component(B3, "3 Conditional Check: Whether Web Query is Needed")
  ComponentDb(B4a, "4a RAG Data Retrieval from Context Database")
  Container(B5, "4b Web Browsing: Call Playwright MCP Server")
  Component(B6, "5 Prompt Assembly: Merge User Input + Context + Query Results")
  Container(B7, "6 Call LLM API")
  Component(B8, "7 Post-processing: Filter, Format, Supplement")
  Container(B9, "8 Memory Storage: Update Conversation History, User Preferences")
  Component(B10, "9 Return Results")
}
System_Boundary(group_Playwright_MCP_Server, "Playwright MCP Server") {
  Component(P1, "Receive MCP Query Request")
  Component(P2, "Launch Headless Browser")
  Container(P3, "Navigate to Target Page")
  Component(P4, "Extract Required Data such as Tables, Prices, Latest Announcements")
  Container(P5, "Return JSON Results")
}

Rel(A, B1, "")
Rel(B1, B2, "")
Rel(B2, B3, "")
Rel(B3, B5, "Yes")
Rel(B3, B4a, "No")
Rel(B4a, B2, "")
Rel(B5, P1, "")
Rel(P1, P2, "")
Rel(P2, P3, "")
Rel(P3, P4, "")
Rel(P4, P5, "")
Rel(P5, B5, "")
Rel(B2, B6, "")
Rel(B6, B7, "")
Rel(B7, E, "")
Rel(E, B8, "")
Rel(B8, B9, "")
Rel(B9, B10, "")
Rel(B10, F, "")
@enduml
