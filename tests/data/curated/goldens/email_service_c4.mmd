        Container(scheduler, "Scheduler")
        Container(smtpout, "SMTP out pool")
        ContainerDb(eventdb, "Event store")
    }
    Boundary(feedback, "Feedback loop") {
        Container(bouncer, "Bounce classifier")
        Container(fbl, "FBL processor")
        ContainerQueue(eventq, "Event queue")
    }
        Container(webhookd, "Webhook dispatcher")
        Container(reputation, "Reputation monitor")
    }
    Rel(customer, apigw, "sends mail")
    Rel(oncall, console, "operates")
