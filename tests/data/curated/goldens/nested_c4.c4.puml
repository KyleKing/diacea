@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Person(user, "User")

System_Boundary(platform, "Platform") {
  System_Boundary(api_app, "API Application") {
    Component(auth, "Auth Controller", "FastAPI", "Validates sessions")
    Component(jobs, "Job Scheduler", "APScheduler", "Queues background work")
  }
  ComponentDb(db, "Database", "PostgreSQL", "Stores jobs and users")
}

Rel(user, auth, "Signs in", "HTTPS")
Rel(auth, jobs, "Enqueues")
Rel(jobs, db, "Reads/writes", "SQL")
@enduml
