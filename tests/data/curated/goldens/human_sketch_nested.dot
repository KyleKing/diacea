digraph "diagram" {
    rankdir="LR";
    node [shape="box", fontname="Helvetica"];
    edge [fontname="Helvetica"];

    subgraph cluster_group_payments_platform {
        label="Payments Platform";
        subgraph cluster_group_workers {
            label="Workers";
            queue [label="Queue", shape="folder"];
            processor [label="Processor"];
        }
        gateway [label="Gateway"];
    }

    gateway -> queue;
    queue -> processor;
}
