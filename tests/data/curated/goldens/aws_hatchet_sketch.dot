digraph "diagram" {
    compound=true;
    rankdir="LR";
    node [shape="box", fontname="Helvetica"];
    edge [fontname="Helvetica"];

    subgraph cluster_group_aws_us_east_1 {
        label="AWS us-east-1";
        subgraph cluster_group_serverless {
            label="Serverless";
            ingest_lambda [label="Ingest Lambda"];
            resize_lambda [label="Resize Lambda"];
        }
        subgraph cluster_group_vpc {
            label="VPC";
            subgraph cluster_group_hatchet_on_ecs {
                label="Hatchet on ECS";
                hatchet_engine [label="Hatchet Engine"];
                postgres [label="Postgres", shape="cylinder"];
                worker_email [label="Worker: email"];
                worker_resize [label="Worker: resize"];
                dashboard [label="Dashboard"];
            }
            alb [label="ALB"];
        }
        api_gw [label="API GW"];
        cognito [label="Cognito"];
        eventbridge [label="EventBridge"];
        s3_uploads [label="S3 uploads", shape="cylinder"];
        notify_lambda [label="Notify Lambda"];
        sqs_jobs [label="SQS jobs", shape="folder"];
        dynamodb [label="DynamoDB", shape="cylinder"];
        ses [label="SES"];
    }

    client [label="Client"];

    client -> api_gw;
    api_gw -> ingest_lambda;
    api_gw -> cognito;
    ingest_lambda -> sqs_jobs;
    sqs_jobs -> hatchet_engine;
    hatchet_engine -> postgres;
    hatchet_engine -> worker_email;
    hatchet_engine -> worker_resize;
    worker_email -> ses;
    resize_lambda -> s3_uploads;
    eventbridge -> notify_lambda;
    resize_lambda -> alb;
    hatchet_engine -> notify_lambda [ltail="cluster_group_hatchet_on_ecs"];
    alb -> hatchet_engine;
}
