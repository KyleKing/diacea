digraph "diagram" {
    rankdir="LR";
    node [shape="box", fontname="Helvetica"];
    edge [fontname="Helvetica"];

    subgraph cluster_group_zone {
        label="Zone";
        store [label="Store", fillcolor="#b2f2bb", style="filled", penwidth="1.0"];
        edge_rider [label="Edge Service", fillcolor="#ffec99", style="filled", penwidth="1.0"];
    }

}
