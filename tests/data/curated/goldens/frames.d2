direction: right

group-host: Host {
  group-runtime: Runtime {
    editor: Editor {
      style: {
        stroke: "#1d1d1d"
        stroke-width: 4
      }
    }
  }

  sidecar: Sidecar {
    style: {
      stroke: "#1d1d1d"
      stroke-width: 4
    }
  }
}


group-host.group-runtime.editor -> group-host.sidecar: sync {
  style: {
    stroke: "#1d1d1d"
    stroke-width: 2
  }
}
