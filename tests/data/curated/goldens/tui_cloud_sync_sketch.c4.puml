@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()


System_Boundary(group_user_laptop_offline_first, "user laptop (offline first)") {
  System_Boundary(group_notes_tui_rust, "notes TUI (Rust)") {
    Component(editor_pane, "editor pane")
    Component(vault_tree, "vault tree")
    Component(cmd_palette, "cmd palette")
    Container(git_panel, "git panel")
    Component(spellcheck, "spellcheck")
    Component(preview_pane, "preview pane")
    Component(keybind_map, "keybind map")
    Component(theme_engine, "theme engine")
    Component(plugin_host, "plugin host")
    Component(wasm_plugins, "wasm plugins")
  }
  System_Boundary(group_sync_daemon, "sync daemon") {
    System_Boundary(group_fs_watcher, "fs watcher") {
      Component(search, "search")
    }
    Component(indexer, "indexer")
    Component(crdt_engine, "crdt engine")
    ComponentDb(sqlite_index, "sqlite index")
    Component(conflict_resolver, "conflict resolver")
    Container(outbox_queue, "outbox queue")
  }
  Component(markdown_files, "markdown files")
  Component(git_repo, "git repo")
  Container(config_toml, "config.toml")
  Component(ssh_agent, "ssh agent")
  Container(kitty_terminal, "kitty terminal")
}
System_Boundary(group_cloud_fly_io_vendors, "cloud (fly.io + vendors)") {
  System_Boundary(group_sync_service, "sync service") {
    Container(sync_api, "sync api")
    Component(auth, "auth")
    Component(crdt_merge, "crdt merge")
    ComponentDb(postgres, "postgres", "PostgreSQL")
    Container(object_store, "object store")
    Component(presence, "presence")
  }
  System_Boundary(group_integrations, "integrations") {
    Container(github_api, "GitHub API")
    Container(openai_api, "OpenAI API")
    Component(caldav, "CalDAV")
    Component(b2_backup, "B2 backup")
    Component(smtp_digest, "smtp digest")
    Component(webhooks_out, "webhooks out")
  }
}

Rel(editor_pane, preview_pane, "uses")
Rel(editor_pane, markdown_files, "uses")
Rel(vault_tree, markdown_files, "uses")
Rel(group_fs_watcher, markdown_files, "uses")
Rel(group_fs_watcher, indexer, "uses")
Rel(crdt_engine, crdt_engine, "uses")
Rel(outbox_queue, sync_api, "uses")
Rel(sync_api, sync_api, "uses")
Rel(crdt_merge, postgres, "uses")
Rel(sync_api, object_store, "uses")
Rel(git_panel, git_repo, "uses")
Rel(git_repo, github_api, "uses")
Rel(plugin_host, openai_api, "uses")
Rel(object_store, b2_backup, "uses")
Rel(sync_api, caldav, "uses")
Rel(presence, webhooks_out, "uses")
@enduml
