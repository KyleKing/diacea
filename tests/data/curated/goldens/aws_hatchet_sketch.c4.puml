@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Person(client, "Client")

System_Boundary(group_aws_us_east_1, "AWS us-east-1") {
  System_Boundary(group_serverless, "Serverless") {
    Container(ingest_lambda, "Ingest Lambda")
    Container(resize_lambda, "Resize Lambda")
  }
  System_Boundary(group_vpc, "VPC") {
    System_Boundary(group_hatchet_on_ecs, "Hatchet on ECS") {
      Component(hatchet_engine, "Hatchet Engine")
      ComponentDb(postgres, "Postgres", "PostgreSQL")
      Container(worker_email, "Worker: email")
      Container(worker_resize, "Worker: resize")
      Container(dashboard, "Dashboard")
    }
    Component(alb, "ALB")
  }
  Container(api_gw, "API GW")
  Component(cognito, "Cognito")
  Component(eventbridge, "EventBridge")
  Container(s3_uploads, "S3 uploads")
  Container(notify_lambda, "Notify Lambda")
  Container(sqs_jobs, "SQS jobs")
  ComponentDb(dynamodb, "DynamoDB")
  Component(ses, "SES")
}

Rel(client, api_gw, "uses")
Rel(api_gw, ingest_lambda, "uses")
Rel(api_gw, cognito, "uses")
Rel(ingest_lambda, sqs_jobs, "uses")
Rel(sqs_jobs, hatchet_engine, "uses")
Rel(hatchet_engine, postgres, "uses")
Rel(hatchet_engine, worker_email, "uses")
Rel(hatchet_engine, worker_resize, "uses")
Rel(worker_email, ses, "uses")
Rel(resize_lambda, s3_uploads, "uses")
Rel(eventbridge, notify_lambda, "uses")
Rel(resize_lambda, alb, "uses")
Rel(group_hatchet_on_ecs, notify_lambda, "uses")
Rel(alb, hatchet_engine, "uses")
Rel(group_hatchet_on_ecs, worker_email, "uses")
@enduml
