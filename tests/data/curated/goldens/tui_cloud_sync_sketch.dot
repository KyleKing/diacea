digraph "diagram" {
    compound=true;
    rankdir="LR";
    node [shape="box", fontname="Helvetica"];
    edge [fontname="Helvetica"];

    subgraph cluster_group_user_laptop_offline_first {
        label="user laptop (offline first)";
        subgraph cluster_group_notes_tui_rust {
            label="notes TUI (Rust)";
            editor_pane [label="editor pane"];
            vault_tree [label="vault tree"];
            cmd_palette [label="cmd palette"];
            git_panel [label="git panel"];
            spellcheck [label="spellcheck"];
            preview_pane [label="preview pane"];
            keybind_map [label="keybind map"];
            theme_engine [label="theme engine"];
            plugin_host [label="plugin host"];
            wasm_plugins [label="wasm plugins"];
        }
        subgraph cluster_group_sync_daemon {
            label="sync daemon";
            subgraph cluster_group_fs_watcher {
                label="fs watcher";
                search [label="search"];
            }
            indexer [label="indexer"];
            crdt_engine [label="crdt engine"];
            sqlite_index [label="sqlite index", shape="cylinder"];
            conflict_resolver [label="conflict resolver"];
            outbox_queue [label="outbox queue", shape="folder"];
        }
        markdown_files [label="markdown files"];
        git_repo [label="git repo"];
        config_toml [label="config.toml"];
        ssh_agent [label="ssh agent"];
        kitty_terminal [label="kitty terminal"];
    }
    subgraph cluster_group_cloud_fly_io_vendors {
        label="cloud (fly.io + vendors)";
        subgraph cluster_group_sync_service {
            label="sync service";
            sync_api [label="sync api"];
            auth [label="auth"];
            crdt_merge [label="crdt merge"];
            postgres [label="postgres", shape="cylinder"];
            object_store [label="object store", shape="cylinder"];
            presence [label="presence"];
        }
        subgraph cluster_group_integrations {
            label="integrations";
            github_api [label="GitHub API"];
            openai_api [label="OpenAI API"];
            caldav [label="CalDAV"];
            b2_backup [label="B2 backup"];
            smtp_digest [label="smtp digest"];
            webhooks_out [label="webhooks out"];
        }
    }

    editor_pane -> preview_pane;
    editor_pane -> markdown_files;
    vault_tree -> markdown_files;
    search -> markdown_files [ltail="cluster_group_fs_watcher"];
    search -> indexer [ltail="cluster_group_fs_watcher"];
    crdt_engine -> crdt_engine;
    outbox_queue -> sync_api;
    sync_api -> sync_api;
    crdt_merge -> postgres;
    sync_api -> object_store;
    git_panel -> git_repo;
    git_repo -> github_api;
    plugin_host -> openai_api;
    object_store -> b2_backup;
    sync_api -> caldav;
    presence -> webhooks_out;
}
