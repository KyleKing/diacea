@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()


System_Boundary(group_payments_platform, "Payments Platform") {
  System_Boundary(group_workers, "Workers") {
    Container(queue, "Queue")
    Component(processor, "Processor")
  }
  Container(gateway, "Gateway")
}

Rel(gateway, queue, "uses")
Rel(queue, processor, "uses")
@enduml
