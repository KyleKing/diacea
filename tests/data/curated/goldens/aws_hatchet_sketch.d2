direction: right

group-aws_us_east_1: AWS us-east-1 {
  group-serverless: Serverless {
    ingest_lambda: Ingest Lambda
    resize_lambda: Resize Lambda
  }

  group-vpc: VPC {
    group-hatchet_on_ecs: Hatchet on ECS {
      hatchet_engine: Hatchet Engine
      postgres: Postgres {
        shape: cylinder
      }
      worker_email: "Worker: email"
      worker_resize: "Worker: resize"
      dashboard: Dashboard
    }

    alb: ALB
  }

  api_gw: API GW
  cognito: Cognito
  eventbridge: EventBridge
  s3_uploads: S3 uploads {
    shape: cylinder
  }
  notify_lambda: Notify Lambda
  sqs_jobs: SQS jobs {
    shape: queue
  }
  dynamodb: DynamoDB {
    shape: cylinder
  }
  ses: SES
}

client: Client {
  shape: person
}

client -> group-aws_us_east_1.api_gw
group-aws_us_east_1.api_gw -> group-aws_us_east_1.group-serverless.ingest_lambda
group-aws_us_east_1.api_gw -> group-aws_us_east_1.cognito
group-aws_us_east_1.group-serverless.ingest_lambda -> group-aws_us_east_1.sqs_jobs
group-aws_us_east_1.sqs_jobs -> group-aws_us_east_1.group-vpc.group-hatchet_on_ecs.hatchet_engine
group-aws_us_east_1.group-vpc.group-hatchet_on_ecs.hatchet_engine -> group-aws_us_east_1.group-vpc.group-hatchet_on_ecs.postgres
group-aws_us_east_1.group-vpc.group-hatchet_on_ecs.hatchet_engine -> group-aws_us_east_1.group-vpc.group-hatchet_on_ecs.worker_email
group-aws_us_east_1.group-vpc.group-hatchet_on_ecs.hatchet_engine -> group-aws_us_east_1.group-vpc.group-hatchet_on_ecs.worker_resize
group-aws_us_east_1.group-vpc.group-hatchet_on_ecs.worker_email -> group-aws_us_east_1.ses
group-aws_us_east_1.group-serverless.resize_lambda -> group-aws_us_east_1.s3_uploads
group-aws_us_east_1.eventbridge -> group-aws_us_east_1.notify_lambda
group-aws_us_east_1.group-serverless.resize_lambda -> group-aws_us_east_1.group-vpc.alb
group-aws_us_east_1.group-vpc.group-hatchet_on_ecs -> group-aws_us_east_1.notify_lambda
group-aws_us_east_1.group-vpc.alb -> group-aws_us_east_1.group-vpc.group-hatchet_on_ecs.hatchet_engine
