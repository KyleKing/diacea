@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

Person(client, "Client")

System_Boundary(group_cloud, "Cloud") {
  System_Boundary(group_vpc, "VPC") {
    System_Boundary(group_cluster, "Cluster") {
      Container(api, "API")
      Container(worker, "Worker")
    }
    ComponentDb(db, "Database")
  }
  Container(gateway, "Gateway")
}

Rel(client, gateway, "uses")
Rel(gateway, api, "uses")
Rel(api, worker, "uses")
Rel(worker, db, "uses")
Rel(api, db, "uses")
@enduml
