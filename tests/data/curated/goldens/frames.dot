digraph "Page 1" {
    rankdir="LR";
    node [shape="box", fontname="Helvetica"];
    edge [fontname="Helvetica"];

    subgraph cluster_group_host {
        label="Host";
        subgraph cluster_group_runtime {
            label="Runtime";
            editor [label="Editor", color="#1d1d1d", penwidth="3.5"];
        }
        sidecar [label="Sidecar", color="#1d1d1d", penwidth="3.5"];
    }

    editor -> sidecar [label="sync", color="#1d1d1d", penwidth="2.0"];
}
