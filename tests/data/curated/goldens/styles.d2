solid_fill: Solid Fill {
  style: {
    fill: "#a5d8ff"
    stroke: "#1e1e1e"
    stroke-width: 1
  }
}
dashed_box: Dashed {
  style: {
    stroke: "#1e1e1e"
    stroke-width: 1
    stroke-dash: 3
  }
}
oval: Ellipse {
  shape: person
  style: {
    fill: "#b2f2bb"
    stroke: "#1e1e1e"
    stroke-width: 1
  }
}
choice: Decision {
  shape: diamond
  style: {
    stroke: "#e03131"
    stroke-width: 1
  }
}

oval -> choice {
  style: {
    stroke: "#1e1e1e"
    stroke-width: 1
  }
}
