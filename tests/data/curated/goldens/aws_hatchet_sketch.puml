@startuml
rectangle "Client" as client
rectangle "AWS us-east-1" as group_aws_us_east_1 {
  rectangle "Serverless" as group_serverless {
    rectangle "Ingest Lambda" as ingest_lambda
    rectangle "Resize Lambda" as resize_lambda
  }
  rectangle "VPC" as group_vpc {
    rectangle "Hatchet on ECS" as group_hatchet_on_ecs {
      rectangle "Hatchet Engine" as hatchet_engine
      database "Postgres" as postgres
      rectangle "Worker: email" as worker_email
      rectangle "Worker: resize" as worker_resize
      rectangle "Dashboard" as dashboard
    }
    rectangle "ALB" as alb
  }
  rectangle "API GW" as api_gw
  rectangle "Cognito" as cognito
  rectangle "EventBridge" as eventbridge
  storage "S3 uploads" as s3_uploads
  rectangle "Notify Lambda" as notify_lambda
  queue "SQS jobs" as sqs_jobs
  database "DynamoDB" as dynamodb
  rectangle "SES" as ses
}
client --> api_gw
api_gw --> ingest_lambda
api_gw --> cognito
ingest_lambda --> sqs_jobs
sqs_jobs --> hatchet_engine
hatchet_engine --> postgres
hatchet_engine --> worker_email
hatchet_engine --> worker_resize
worker_email --> ses
resize_lambda --> s3_uploads
eventbridge --> notify_lambda
resize_lambda --> alb
group_hatchet_on_ecs --> notify_lambda
alb --> hatchet_engine
group_hatchet_on_ecs --> worker_email
@enduml
