direction: right

group-user_laptop_offline_first: user laptop (offline first) {
  group-notes_tui_rust: notes TUI (Rust) {
    editor_pane: editor pane
    vault_tree: vault tree
    cmd_palette: cmd palette
    git_panel: git panel
    spellcheck: spellcheck
    preview_pane: preview pane
    keybind_map: keybind map
    theme_engine: theme engine
    plugin_host: plugin host
    wasm_plugins: wasm plugins
  }

  group-sync_daemon: sync daemon {
    group-fs_watcher: fs watcher {
      search: search
    }

    indexer: indexer
    crdt_engine: crdt engine
    sqlite_index: sqlite index {
      shape: cylinder
    }
    conflict_resolver: conflict resolver
    outbox_queue: outbox queue {
      shape: queue
    }
  }

  markdown_files: markdown files
  git_repo: git repo
  config_toml: config.toml {
    shape: document
  }
  ssh_agent: ssh agent
  kitty_terminal: kitty terminal
}

group-cloud_fly_io_vendors: cloud (fly.io + vendors) {
  group-sync_service: sync service {
    sync_api: sync api
    auth: auth
    crdt_merge: crdt merge
    postgres: postgres {
      shape: cylinder
    }
    object_store: object store {
      shape: cylinder
    }
    presence: presence
  }

  group-integrations: integrations {
    github_api: GitHub API
    openai_api: OpenAI API
    caldav: CalDAV
    b2_backup: B2 backup
    smtp_digest: smtp digest
    webhooks_out: webhooks out
  }

}


