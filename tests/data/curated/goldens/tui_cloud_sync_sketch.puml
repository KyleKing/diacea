@startuml
rectangle "user laptop (offline first)" as group_user_laptop_offline_first {
  rectangle "notes TUI (Rust)" as group_notes_tui_rust {
    rectangle "editor pane" as editor_pane
    rectangle "vault tree" as vault_tree
    rectangle "cmd palette" as cmd_palette
    rectangle "git panel" as git_panel
    rectangle "spellcheck" as spellcheck
    rectangle "preview pane" as preview_pane
    rectangle "keybind map" as keybind_map
    rectangle "theme engine" as theme_engine
    rectangle "plugin host" as plugin_host
    rectangle "wasm plugins" as wasm_plugins
  }
  rectangle "sync daemon" as group_sync_daemon {
    rectangle "fs watcher" as group_fs_watcher {
      rectangle "search" as search
    }
    rectangle "indexer" as indexer
    rectangle "crdt engine" as crdt_engine
    database "sqlite index" as sqlite_index
    rectangle "conflict resolver" as conflict_resolver
    queue "outbox queue" as outbox_queue
  }
  rectangle "markdown files" as markdown_files
  rectangle "git repo" as git_repo
  rectangle "config.toml" as config_toml
  rectangle "ssh agent" as ssh_agent
  rectangle "kitty terminal" as kitty_terminal
}
rectangle "cloud (fly.io + vendors)" as group_cloud_fly_io_vendors {
  rectangle "sync service" as group_sync_service {
    rectangle "sync api" as sync_api
    rectangle "auth" as auth
    rectangle "crdt merge" as crdt_merge
    database "postgres" as postgres
    storage "object store" as object_store
    rectangle "presence" as presence
  }
  rectangle "integrations" as group_integrations {
    rectangle "GitHub API" as github_api
    rectangle "OpenAI API" as openai_api
    rectangle "CalDAV" as caldav
    rectangle "B2 backup" as b2_backup
    rectangle "smtp digest" as smtp_digest
    rectangle "webhooks out" as webhooks_out
  }
}
editor_pane --> preview_pane
editor_pane --> markdown_files
vault_tree --> markdown_files
group_fs_watcher --> markdown_files
group_fs_watcher --> indexer
crdt_engine --> crdt_engine
outbox_queue --> sync_api
sync_api --> sync_api
crdt_merge --> postgres
sync_api --> object_store
git_panel --> git_repo
git_repo --> github_api
plugin_host --> openai_api
object_store --> b2_backup
sync_api --> caldav
presence --> webhooks_out
@enduml
