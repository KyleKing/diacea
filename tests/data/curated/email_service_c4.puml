@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Transactional email service (design review 2026-07)

Person(customer, "Customer engineer", "Integrates via REST or SMTP")
Person(oncall, "On-call operator")
System_Ext(recipients, "Recipient mail servers")
System_Ext(dnsprov, "DNS provider", "SPF/DKIM records")

System_Boundary(emailsvc, "Email service") {
    Container(apigw, "Public API", "REST + SMTP ingest")
    Container(console, "Admin console", "React SPA")
    ContainerDb(maindb, "Control DB", "Postgres", "tenants, domains, API keys")

    System_Boundary(pipeline, "Delivery pipeline") {
        Container(validator, "Validator", "syntax, suppression list, DKIM signing")
        ContainerQueue(sendq, "Send queue", "Kafka")
        Container(scheduler, "Scheduler", "rate limits per recipient domain")
        Container(smtpout, "SMTP out pool", "connection cache, retry ladder")
        ContainerDb(eventdb, "Event store", "ClickHouse", "opens, clicks, bounces")
    }

    System_Boundary(feedback, "Feedback loop") {
        Container(bouncer, "Bounce classifier")
        Container(fbl, "FBL processor", "abuse reports")
        ContainerQueue(eventq, "Event queue", "Kafka")
    }

    Container(webhookd, "Webhook dispatcher", "at-least-once, HMAC signed")
    Container(reputation, "Reputation monitor", "IP warmup, blocklist checks")
}

Rel(customer, apigw, "sends mail", "HTTPS/SMTP")
Rel(oncall, console, "operates")
Rel(console, maindb, "reads config")
Rel(apigw, maindb, "authenticates against")
Rel(apigw, validator, "enqueues")
Rel(validator, sendq, "publishes")
Rel(sendq, scheduler, "consumes")
Rel(scheduler, smtpout, "dispatches")
Rel(smtpout, recipients, "delivers", "SMTP")
Rel(recipients, bouncer, "DSN bounces")
Rel(recipients, fbl, "abuse reports")
Rel(bouncer, eventq, "publishes")
Rel(fbl, eventq, "publishes")
Rel(eventq, eventdb, "sinks to")
Rel(eventq, webhookd, "fans out to")
Rel(webhookd, customer, "notifies", "HTTPS")
Rel(reputation, dnsprov, "verifies records")
Rel(reputation, smtpout, "throttles")
Rel(scheduler, eventdb, "reads domain stats")
@enduml
